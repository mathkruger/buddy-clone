<%- include('partials/head') %>

  <%- include('partials/site-header') %>

  <main class="search-page">
    <section class="search-card">
      <h1>Search buddies</h1>
      <p class="login-sub">Look up friends by username and open their profiles.</p>
      <form id="search-form" class="search-form" novalidate>
        <input id="search-query" name="q" type="text" maxlength="40"
               placeholder="e.g. bunny" autocomplete="off" spellcheck="false">
        <button type="submit" class="primary">Search</button>
      </form>
      <p id="search-status" class="form-error" role="status"></p>
      <div id="search-results" class="search-results"></div>
    </section>
  </main>

  <%- include('partials/clouds') %>
  <%- include('partials/footer') %>
  <script type="module" src="/search.js"></script>
  <%- include('partials/foot') %>