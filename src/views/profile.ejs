<%- include('partials/head') %>

  <%- include('partials/site-header') %>

  <main class="container">
    <div class="profile-card" id="profile-root" hidden>
      <div class="profile-header">
        <div class="profile-avatar" id="profile-avatar"></div>
        <div class="profile-title">
          <h1 id="profile-username"></h1>
          <p class="mood-line">mood <span id="profile-mood" class="mood-badge"></span></p>
          <p class="mood-line" id="profile-created"></p>
          <p class="mood-line" id="profile-stats"></p>
        </div>
      </div>

      <div class="profile-actions" id="profile-actions"></div>
      <div id="favorite-area"></div>
      <div id="profile-editors"></div>

      <section class="embed-section" id="embed-section">
        <h2>Share your buddy</h2>
        <p>Drop this into your blog, forum or profile page:</p>
        <div class="embed-snippet">
          <textarea id="embed-snippet" readonly spellcheck="false"></textarea>
          <button type="button" class="btn copy-btn" id="copy-snippet">Copy</button>
        </div>
      </section>

      <section class="interactions">
        <h2>Poke <span id="interaction-target"></span></h2>
        <div class="interaction-buttons" id="interaction-buttons"></div>
        <div class="interaction-stage" id="interaction-stage"></div>
        <div class="interaction-history" id="interaction-history"></div>
      </section>
    </div>

    <div class="not-found" id="not-found" hidden>
      <div class="big">?</div>
      <h1>Nobody here by that name</h1>
      <p>This buddy does not exist — or wandered off to a different corner of the internet.</p>
      <p><a class="btn btn-link" href="/">Make your own buddy</a></p>
    </div>
  </main>

  <%- include('partials/clouds') %>
  <script type="application/json" id="buddy-profile"><%- profileJson %></script>
  <script type="module" src="/profile.js"></script>
  <script type="module" src="/interactions.js"></script>
  <%- include('partials/foot') %>