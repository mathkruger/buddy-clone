<%- include('partials/head') %>

  <%- include('partials/site-header') %>

  <main class="builder">
    <% if (viewer) { %>
      <section class="logged-in-only">
        <div class="favorite-guest">
          <p>You're already logged in as
            <a href="/<%= encodeURIComponent(viewer) %>"><%= viewer %></a>.</p>
          <p>Log out before creating a new buddy.</p>
        </div>
      </section>
    <% } else { %>
      <section class="preview-panel">
        <div id="builder-preview" class="avatar-frame" aria-label="Live avatar preview"></div>
        <p id="builder-mood-name" class="mood-name">feeling happy</p>
      </section>

      <section class="controls-panel">
        <div id="builder-pickers"></div>

        <div id="builder-colors" class="color-groups"></div>

        <form id="save-form" class="save-form" novalidate>
          <label for="username">Pick a username</label>
          <div class="save-row">
            <input id="username" name="username" type="text" maxlength="24" placeholder="e.g. bunny" autocomplete="off" spellcheck="false">
          </div>
          <label for="password">Pick a password</label>
          <div class="save-row">
            <input id="password" name="password" type="password" maxlength="200" placeholder="at least 8 characters" autocomplete="new-password">
            <button type="submit" class="primary">Claim my buddy</button>
          </div>
          <p class="save-hint">Your password is what you'll use to log back in — the browser keeps no token.</p>
          <p id="save-error" class="form-error" role="alert"></p>
          <div id="save-success" class="save-success" hidden>
            <p>Your buddy is live!</p>
            <a id="profile-link" href="#">Visit your profile</a>
          </div>
        </form>
      </section>
    <% } %>
  </main>

  <%- include('partials/clouds') %>
  <%- include('partials/footer') %>
  <script type="module" src="/builder.js"></script>
  <%- include('partials/foot') %>