<%- include('partials/head') %>

  <%- include('partials/site-header') %>

  <main class="landing">
    <section class="hero">
      <h1>Make a buddy, keep it forever.</h1>
      <p class="hero-sub">
        Buddy Clone brings the tiny pixel charms of the Buddy Poke era back to your corner of
        the internet. Craft an avatar, visit friends, poke them silly, and keep the buddies you
        like close.
      </p>
    </section>

    <div class="entry-grid">
      <a class="entry-card" href="/create">
        <span class="entry-emoji" aria-hidden="true">&#x1F47B;</span>
        <h2>Create a buddy</h2>
        <p>Build a brand-new avatar and claim its username.</p>
      </a>
      <a class="entry-card" href="/login">
        <span class="entry-emoji" aria-hidden="true">&#x1F511;</span>
        <h2>Log in</h2>
        <p>Returning owner? Hop back onto your own buddy.</p>
      </a>
      <a class="entry-card" href="/search">
        <span class="entry-emoji" aria-hidden="true">&#x1F50D;</span>
        <h2>Search buddies</h2>
        <p>Find friends by username and open their profiles.</p>
      </a>
    </div>
  </main>

  <%- include('partials/clouds') %>
  <%- include('partials/footer') %>
  <%- include('partials/foot') %>