<%- include('partials/head') %>

  <%- include('partials/site-header') %>

  <main class="landing">
    <section class="hero">
      <h1>Make a buddy, keep it forever.</h1>
      <p class="hero-sub">
        Buddy Clone brings the tiny pixel charms of the Buddy Poke era back to your corner of
        the internet. Register a buddy, set its humor, poke your friends, and keep the buddies you
        like close — all from one play screen.
      </p>
    </section>

    <div class="entry-grid">
      <a class="entry-card" href="/register">
        <span class="entry-emoji" aria-hidden="true">&#x1F47B;</span>
        <h2>Make a buddy</h2>
        <p>Register an account and your buddy gets the simple default look — customize it later.</p>
      </a>
      <a class="entry-card" href="/login">
        <span class="entry-emoji" aria-hidden="true">&#x1F511;</span>
        <h2>Hop back onto your buddy</h2>
        <p>Returning owner? Log in and find your buddy waiting on the play screen.</p>
      </a>
    </div>
  </main>

